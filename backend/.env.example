# =====================================================================
# Plantilla de variables de entorno del backend.
# Copia este archivo como `.env` y completa los valores reales en local.
# NUNCA subas tu .env real al repositorio (esta ignorado por .gitignore).
# En produccion (Render), las variables se configuran desde el panel o
# desde render.yaml. No hagas commit de credenciales reales.
# =====================================================================

# Entorno: development | test | production
NODE_ENV=development

# Puerto del servidor HTTP. En Render se inyecta automaticamente.
PORT=3000

# Secret para firmar JWT. En produccion debe ser una cadena aleatoria larga.
# Render puede autogenerar este valor cuando se define con `generateValue: true`
# en render.yaml.
JWT_SECRET=cambia-esto-por-una-cadena-aleatoria-larga

# Vigencia del token JWT (formato de jsonwebtoken: "1h", "7d", "30m"...).
JWT_EXPIRES_IN=1h

# Cadena de conexion completa a PostgreSQL (solo produccion).
# En Render se inyecta automaticamente al vincular la base de datos al servicio.
# Formato: postgres://usuario:password@host:5432/nombre_bd
# DATABASE_URL=postgres://user:password@host:5432/dbname
